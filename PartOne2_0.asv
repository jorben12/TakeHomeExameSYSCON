%Part1
clear all
close all

z1 =[0+45i 0-45i];
p1 =[-1 -2000];

z2 =  [0+500i 0-500i];
p2 =  [-1 -300000];

k = 1;
sys1 = zpk(z1,p1,k);
sys2 = zpk(z2, p2, k);

sys = sys2 * sys1;

figure(1)
bode(sys)
hold on
bode(sys1)
hold on
bode(sys2)

[A,B] = tfdata(sys1)
[A,B] = tfdata(sys2)

A1 =[1/44.99^2 0 1];
B1 = [1/44.99^2 0.988 1];

A2 = [1/500^2 0 1];
B2 = [1/500^2 1.2 1];

sysA = tf(A1,B1);
sysB = tf(A2,B2);
sysC = sysA*sysB;

figure(2)
bode(sysC)


figure(3)
pzmap(sys)

%%
%Part 2 

clear all
close all
load tf04.mat

figure(1);
bode(sys); 

figure(2);
pzmap(sys);

figure(3);
step(sys);


[Gm,Pm,Wcp, Wvp] = margin(sys);
Gm_dB = 20*log10(Gm)
Wcp

figure(4);
rlocus(sys);

%%
%Part 3 
clear all
close all
load tf04.mat

[Gm,Pm,Wcp, Wvp] = margin(sys);

Gm
Wcp
T =2 * pi/Wcp

Kzn = 0.6*Gm;
TIzn = T/2;
TDzn = T/8;

%voorbereidingen simulink inputs met KZ parmater
t = (0:0.0001:5)';

k = Kzn;
KI = 1/(TIzn*Kzn)
KD = TDzn/Kzn;
TaS = 1

out = sim('PID_controler.slx');

figure(1)
plot(t,out.simout);

%PID contorler met verbeterde parameters
k = 1;
KI = 1/(TIzn*Kzn);
KD = 0;
TaS = 0;

out = sim('PID_controler.slx');

figure(2)
plot(t,out.simout);